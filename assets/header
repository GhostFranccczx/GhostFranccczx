<svg width="900" height="290" viewBox="0 0 900 290" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="GhostFranccczx — developer and designer" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <style>
    :root { --fg:#111111; --mut:#6b7280; --acc:#e5484d; --line:#d4d4d8; }
    @media (prefers-color-scheme: dark) {
      :root { --fg:#f5f5f4; --mut:#9ca3af; --acc:#ff6b6b; --line:#3f3f46; }
    }

    .kicker { font: 500 12px 'SF Mono', Menlo, Consolas, monospace; letter-spacing: 5px; fill: var(--mut);
              opacity: 0; animation: rise .8s .1s ease-out forwards; }
    .ch     { font: 300 66px Georgia, 'Times New Roman', serif; fill: var(--fg); text-anchor: middle;
              transform-box: fill-box; transform-origin: 50% 80%; opacity: 0;
              animation: fadein .6s ease-out forwards, dance 2.2s ease-in-out infinite; }
    .ch.a   { font-style: italic; fill: var(--acc); }
    .rule   { stroke: var(--line); stroke-width: 1; stroke-dasharray: 840; stroke-dashoffset: 840;
              animation: draw 1.6s .9s ease-in-out forwards; }
    .role   { font: 400 18px 'SF Mono', Menlo, Consolas, monospace; fill: var(--fg); opacity: 0;
              animation: cycle 9s infinite; }
    .role b { fill: var(--acc); font-weight: 600; }
    .r2 { animation-delay: 3s; }
    .r3 { animation-delay: 6s; }
    .dot { fill: var(--acc); animation: pulse 2s ease-in-out infinite; transform-origin: 30px 66px; }
    .foot { font: 400 12px 'SF Mono', Menlo, Consolas, monospace; letter-spacing: 2px; fill: var(--mut);
            opacity: 0; animation: rise .8s 1.8s ease-out forwards; }

    @keyframes rise  { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @keyframes fadein { to { opacity: 1; } }
    @keyframes dance {
      0%,100% { transform: translateY(0) rotate(0deg); }
      20%     { transform: translateY(-18px) rotate(-7deg); }
      40%     { transform: translateY(0) rotate(0deg); }
      60%     { transform: translateY(-10px) rotate(7deg); }
      80%     { transform: translateY(0) rotate(0deg); }
    }
    @keyframes draw  { to { stroke-dashoffset: 0; } }
    @keyframes pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.8); opacity: .35; } }
    @keyframes cycle {
      0%   { opacity: 0; transform: translateY(8px); }
      6%   { opacity: 1; transform: none; }
      27%  { opacity: 1; transform: none; }
      33%  { opacity: 0; transform: translateY(-8px); }
      100% { opacity: 0; }
    }
  </style>

